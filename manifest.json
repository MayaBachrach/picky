{
  "manifest_version": 3,
  "name": "PICKY",
  "version": "0.4.6",
  "minimum_chrome_version": "127",
  "description": "Pick, copy, and save your favorite colors. By Maya Bachrach.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PICKY",
    "default_icon": {
      "16": "icons/picky-16.png",
      "32": "icons/picky-32.png",
      "48": "icons/picky-48.png",
      "128": "icons/picky-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/picky-16.png",
    "32": "icons/picky-32.png",
    "48": "icons/picky-48.png",
    "128": "icons/picky-128.png"
  }
}
